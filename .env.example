# LLM
LLM_BASE_URL=https://llm.jetstream-cloud.org/llama-4-scout/v1/
OPENROUTER_API_KEY=none
LLM_MODEL=llama-4-scout

# HPC (SSH tunnel)
HPC_HOST=
HPC_USER=
HPC_WORKDIR=~/peat_runs
HPC_PARTITION=gpu
HPC_QOS=gpu
HPC_ACCOUNT=
HPC_PRIVATE_KEY=
HPC_TIMEOUT_SECONDS=300
GROMACS_MODULE=gromacs/2024.1

# Globus Compute (legacy — not required if using SSH tunnel)
GLOBUS_COMPUTE_ENDPOINT_ID=
GLOBUS_CLIENT_ID=
GLOBUS_CLIENT_SECRET=

# Literature retrieval
UNPAYWALL_EMAIL=
LIBRARY_COOKIE=
SCIHUB_ENABLED=false
SCIHUB_URL=https://sci-hub.se
